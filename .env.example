# Copy to .env (gitignored). Never commit real values.
# Comma-separated provider order for the LLM client (names only; no model IDs).
# P1 baseline uses Gemini free tier; the Groq adapter remains in the repo unused.
LLM_PROVIDER_CHAIN=gemini
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# docker-compose.yml maps host 127.0.0.1:7888 to the container's Bolt port 7687
# and 127.0.0.1:7475 to the browser UI. These avoid V1's 7474/7887.
NEO4J_URI=bolt://127.0.0.1:7888
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
CROSSREF_CONTACT_EMAIL=
EUROPEPMC_CONTACT_EMAIL=
AXION_API_KEY=

# Europe PMC polite client. The contact email above is required for live calls.
# Raw responses cache under AXION_DATA_DIR/raw/europepmc unless EUROPEPMC_CACHE_DIR is set.
EUROPEPMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
EUROPEPMC_MIN_INTERVAL_S=1
EUROPEPMC_TIMEOUT_S=30
EUROPEPMC_MAX_ATTEMPTS=3
EUROPEPMC_CACHE_DIR=

# Runtime behavior. Keep dry-run true until you are ready to spend a provider call.
AXION_DRY_RUN=true
AXION_DATA_DIR=data
AXION_PRICING_PATH=
AXION_LEDGER_PATH=data/ledger.sqlite3

# LLM tiers, retry/cooldown policy, cache, and generation config.
# P1 baseline tiers: small = gemini-3.5-flash-lite; large = gemini-3.8-flash.
# Free-tier calls record list price but real spend stays zero (LLM_BILLING=free_tier).
LLM_SMALL_MODEL=gemini-3.5-flash-lite
LLM_LARGE_MODEL=gemini-3.8-flash
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_S=5
LLM_RETRY_MAX_S=120
LLM_RETRY_JITTER_S=1
LLM_COOLDOWN_S=300
LLM_CACHE_ENABLED=true
LLM_BILLING=free_tier
# Baseline thinking level is fixed for P1; thinking effort is a P2 cost lever.
LLM_THINKING_LEVEL=medium
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.0
