# Copy to .env (gitignored). Never commit real values.
# Comma-separated provider order for the LLM client (names only; no model IDs).
# Day-0 decision: one Groq provider for now; add fallbacks later.
LLM_PROVIDER_CHAIN=groq
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
CROSSREF_CONTACT_EMAIL=
EUROPEPMC_CONTACT_EMAIL=
AXION_API_KEY=

# Runtime behavior. Keep dry-run true until verified prices are supplied (P1-10).
AXION_DRY_RUN=true
AXION_DATA_DIR=data
AXION_PRICING_PATH=
AXION_LEDGER_PATH=data/ledger.sqlite3

# LLM tiers, retry/cooldown policy, and cache. Model IDs are configuration, not code.
# Fill both tier model IDs with the Groq models you choose; leave blank until decided.
# Pricing stays empty and dry-run stays fail-closed until you supply verified prices.
LLM_SMALL_MODEL=
LLM_LARGE_MODEL=
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_S=5
LLM_RETRY_MAX_S=120
LLM_RETRY_JITTER_S=1
LLM_COOLDOWN_S=300
LLM_CACHE_ENABLED=true
